{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDirs": [
      "accordion",
      "badge",
      "button",
      "checkbox",
      "checkbox-group",
      "collapsible",
      "dialog",
      "input",
      "number-field",
      "radio-group",
      "slider",
      "switch",
      "tabs",
      "textarea",
      "card",
      "separator",
      "kbd",
      "skeleton",
      "progress",
      "theme",
      "toggle",
      "toggle-group"
    ]
  },
  "include": [
    "*/core.ts",
    "theme/theme.ts",
    "theme/themes/*.ts"
  ]
}
