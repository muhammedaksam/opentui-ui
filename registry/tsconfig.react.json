{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "noEmit": true,
    "rootDirs": [
      "accordion",
      "badge",
      "button",
      "checkbox",
      "checkbox-group",
      "collapsible",
      "dialog",
      "input",
      "number-field",
      "radio-group",
      "slider",
      "switch",
      "tabs",
      "textarea",
      "card",
      "separator",
      "kbd",
      "skeleton",
      "progress",
      "spinner",
      "table",
      "breadcrumb",
      "theme",
      "toggle",
      "toggle-group",
      "shims/react"
    ]
  },
  "include": [
    "*/react.tsx"
  ]
}
